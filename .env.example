# Airlock 環境変数(ローカル実行/デプロイ共通)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global          # Gemini 3.5 は Vertex の global エンドポイント
GOOGLE_GENAI_USE_VERTEXAI=TRUE        # Vertex AI 経由(Gemini API直ではなく)
AUDIT_TOPIC=airlock-audit             # Pub/Sub トピック名
AIRLOCK_MODEL=gemini-3.5-flash        # 使用モデル(要件: Gemini 3.5 以降)
